# Managed by CentralDevOps bootstrap.
server {
    listen 80;
    server_name {{ bootstrap_route.fqdn }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{ bootstrap_route.fqdn }};

    ssl_certificate /etc/letsencrypt/live/{{ bootstrap_route.fqdn }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ bootstrap_route.fqdn }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 ipv6=off valid=30s;

    location / {
        set $bootstrap_upstream {{ bootstrap_route.upstream }};
        proxy_pass http://$bootstrap_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
