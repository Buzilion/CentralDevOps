#!/usr/bin/env bash
# Managed by CentralDevOps bootstrap.
set -euo pipefail
umask 077

container="{{ bootstrap_postgresql_container_name }}"
aws_image="{{ bootstrap_aws_cli_image }}"
endpoint="{{ bootstrap_postgresql_s3_endpoint }}"
bucket="{{ bootstrap_postgresql_bucket }}"
{% if bootstrap_postgresql_backup_namespace %}
prefix="bootstrap/{{ bootstrap_postgresql_backup_namespace }}/{{ bootstrap_application_environment }}/{{ bootstrap_host_id }}/postgresql"
{% else %}
prefix="bootstrap/{{ bootstrap_environment }}/{{ bootstrap_host_id }}/postgresql"
{% endif %}
writer_env="{{ bootstrap_postgresql_config_directory }}/s3-writer.env"
restore_env="{{ bootstrap_postgresql_config_directory }}/s3-restore.env"
state_directory="{{ bootstrap_postgresql_state_directory }}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
object_key="${prefix}/${timestamp}.dump"
restore_database="bootstrap_restore_test_$(date -u +%s)"

mkdir -p "$state_directory"

docker exec --user root "$container" sh -c \
  'PGPASSWORD="$(cat /run/secrets/{{ bootstrap_postgresql_compose_secret_name }})" pg_dump -h 127.0.0.1 -w -Fc -U {{ bootstrap_postgresql_database_user }} -d {{ bootstrap_postgresql_database_name }}' \
  | docker run --rm -i --env-file "$writer_env" "$aws_image" \
      s3 cp - "s3://${bucket}/${object_key}" \
      --endpoint-url "$endpoint" \
      --region "{{ bootstrap_postgresql_s3_region }}" \
      --sse AES256 \
      --no-cli-pager

encryption="$(
  docker run --rm --env-file "$restore_env" "$aws_image" \
    s3api head-object \
    --bucket "$bucket" \
    --key "$object_key" \
    --endpoint-url "$endpoint" \
    --region "{{ bootstrap_postgresql_s3_region }}" \
    --query ServerSideEncryption \
    --output text \
    --no-cli-pager
)"
if [[ "$encryption" != "AES256" ]]; then
  printf 'Uploaded backup did not report AES256 server-side encryption.\n' >&2
  exit 1
fi

printf '%s\n' "$object_key"

if [[ "${1:-}" == "--initial-restore-test" ]]; then
  cleanup() {
    docker exec --user root "$container" sh -c \
      'PGPASSWORD="$(cat /run/secrets/{{ bootstrap_postgresql_compose_secret_name }})" dropdb -h 127.0.0.1 -w --if-exists -U {{ bootstrap_postgresql_database_user }} "$1"' \
      bootstrap "$restore_database" \
        >/dev/null 2>&1 || true
  }
  trap cleanup EXIT

  docker exec --user root "$container" sh -c \
    'PGPASSWORD="$(cat /run/secrets/{{ bootstrap_postgresql_compose_secret_name }})" createdb -h 127.0.0.1 -w -U {{ bootstrap_postgresql_database_user }} "$1"' \
    bootstrap "$restore_database"
  docker run --rm --env-file "$restore_env" "$aws_image" \
    s3 cp "s3://${bucket}/${object_key}" - \
    --endpoint-url "$endpoint" \
    --region "{{ bootstrap_postgresql_s3_region }}" \
    --no-cli-pager \
    | docker exec -i --user root "$container" sh -c \
        'PGPASSWORD="$(cat /run/secrets/{{ bootstrap_postgresql_compose_secret_name }})" pg_restore -h 127.0.0.1 -w -U {{ bootstrap_postgresql_database_user }} -d "$1" --exit-on-error --no-owner' \
        bootstrap "$restore_database"
  cleanup
  trap - EXIT
  date -u +%s > "${state_directory}/initial-restore-verified.tmp"
  mv "${state_directory}/initial-restore-verified.tmp" \
    "${state_directory}/initial-restore-verified"
fi

date -u +%s > "${state_directory}/last-backup-success.tmp"
printf ' %s\n' "$object_key" >> "${state_directory}/last-backup-success.tmp"
mv "${state_directory}/last-backup-success.tmp" \
  "${state_directory}/last-backup-success"
